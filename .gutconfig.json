# GUT Configuration for Voxel Terrain System Tests
#
# To run tests:
# 1. Open Godot
# 2. Go to Project > Project Settings > Plugins
# 3. Enable "Gut" plugin
# 4. In the editor, go to the GUT panel (bottom dock)
# 5. Click "Run All"
#
# Or from command line:
# godot --script addons/gut/gut_cmdln.gd -gdir=res://test/unit -gexit

[guts]
dirs = ["res://test/unit"]
should_exit = true
should_exit_on_success = true
log_level = 1
